---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { content, type Lang } from "../i18n/content";
import { withBase, langHref } from "../utils/paths";

interface Props {
  lang: Lang;
  /** Slug della pagina corrente: "" per Home, "shop", "journal", "about", "contact". */
  slug?: string;
}

const { lang, slug = "" } = Astro.props;
const t = content[lang];

const metaKey = (slug || "home") as keyof typeof t.meta;
const pageMeta = t.meta[metaKey];

const hreflangUrl = (targetLang: Lang) => new URL(withBase(langHref(targetLang, slug)), Astro.site).toString();
const canonicalUrl = new URL(withBase(langHref(lang, slug)), Astro.site).toString();
const ogImageUrl = new URL(withBase("/images/01-negozio.jpg"), Astro.site).toString();
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={withBase("/logo.png")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <title>{pageMeta.title}</title>
    <meta name="description" content={pageMeta.description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="ja" href={hreflangUrl("ja")} />
    <link rel="alternate" hreflang="it" href={hreflangUrl("it")} />
    <link rel="alternate" hreflang="en" href={hreflangUrl("en")} />
    <link rel="alternate" hreflang="x-default" href={hreflangUrl("ja")} />
    <meta property="og:title" content={pageMeta.title} />
    <meta property="og:description" content={pageMeta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1182" />
    <meta property="og:image:height" content="886" />
  </head>
  <body class="font-body">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-ivory focus:px-4 focus:py-3 focus:font-body focus:text-sm focus:text-charcoal focus:shadow-lg"
    >
      {t.skipToContent}
    </a>
    <Header lang={lang} t={t} slug={slug} transparent={slug === ""} />
    <main id="main-content" class={slug === "" ? "" : "pt-[72px] sm:pt-20"}>
      <slot />
    </main>
    <Footer lang={lang} t={t} slug={slug} />
  </body>
</html>
