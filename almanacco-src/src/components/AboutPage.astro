---
import BaseLayout from "../layouts/BaseLayout.astro";
import { content, type Lang } from "../i18n/content";
import { withBase, langHref } from "../utils/paths";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
---

<BaseLayout lang={lang} slug="about">
  <section class="border-b border-brass/30">
    <img
      src={withBase("/images/03-colline-storia.jpg")}
      alt={t.storia.imageAlt}
      class="h-[45vh] w-full object-cover"
      loading="eager"
    />
  </section>

  <section class="bg-ivory py-24">
    <div class="mx-auto max-w-2xl px-6">
      <p class="divider-dot flex items-center gap-2 font-body text-xs uppercase tracking-[0.2em] text-forest">
        {t.storia.kicker}
      </p>
      <h1 class="mt-4 font-display text-4xl uppercase tracking-wide text-charcoal sm:text-5xl">
        {t.storia.title}
      </h1>
      <div class="mt-10 space-y-6">
        {t.storia.paragraphs.map((p) => (
          <p class="font-body text-base leading-relaxed text-stone-text">{p}</p>
        ))}
      </div>

      <div class="mt-10">
        <img
          src={withBase("/images/about/fondatori-giovanni-ikuya.jpg")}
          alt={t.storia.foundersImageAlt}
          class="aspect-[4/3] w-full border border-brass/30 object-cover sm:aspect-[16/9]"
          loading="lazy"
        />
        <p class="mt-3 text-center font-body text-xs uppercase tracking-[0.15em] text-stone-text">
          {t.storia.foundersCaption}
        </p>
      </div>

      <a
        href={withBase(langHref(lang, "shop"))}
        class="mt-12 inline-block bg-forest px-8 py-3 font-body text-sm uppercase tracking-[0.15em] text-ivory transition-colors hover:bg-forest/85"
      >
        {t.categories.ctaLabel} →
      </a>
    </div>
  </section>

  <section class="border-t border-brass/30 bg-ivory-soft py-24">
    <div class="mx-auto max-w-5xl px-6">
      <p class="divider-dot flex items-center gap-2 font-body text-xs uppercase tracking-[0.2em] text-forest">
        {t.storia.behindScenesKicker}
      </p>
      <p class="mt-4 max-w-xl font-subtitle text-xl italic leading-relaxed text-stone-text">
        {t.storia.behindScenesNote}
      </p>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {t.storia.behindScenesImages.map((img) => (
          <img
            src={withBase(img.src)}
            alt={img.alt}
            class="aspect-square w-full border border-brass/30 object-cover"
            loading="lazy"
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
